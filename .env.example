# --- Ollama (padrão, grátis / local) ---
# Docker Compose (api/worker em container): host.docker.internal
# Dev local (api/worker no host): localhost
# Snap Ollama precisa escutar fora do loopback, senão o Docker não alcança:
#   sudo snap set ollama host=0.0.0.0:11434 && sudo snap restart ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Opcional: bases separadas (caem em LLM_BASE_URL)
# CHAT_BASE_URL=http://localhost:11434/v1
# EMBED_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
CHAT_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBED_DOC_PREFIX=search_document: 
EMBED_QUERY_PREFIX=search_query: 
EMBED_BATCH_SIZE=16
LLM_TIMEOUT_MS=120000

# --- OpenAI (opcional; exige reindexar se a dimensão mudar) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBED_DOC_PREFIX=
# EMBED_QUERY_PREFIX=
# EMBED_BATCH_SIZE=64

ASK_TOP_K=8
ASK_LOG_ENABLED=false
MAX_REPO_SIZE_BYTES=52428800
MAX_FILE_COUNT=2000
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://repolens:repolens@localhost:5432/repolens
REDIS_URL=redis://localhost:6379
